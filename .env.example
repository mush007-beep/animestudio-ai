# --- Static site (GitHub Pages) ---
# Baked into the build. This is OBSCURITY, not real security: on a public
# GitHub Pages site anyone can read it from the JS bundle. It only keeps
# casual visitors out. Real auth arrives with the future Vercel backend.
# Leave empty to disable the password gate entirely.
NEXT_PUBLIC_ANIME_STUDIO_PASSWORD=

# --- GitHub Pages base path ---
# Set to /<repo-name> when building for Pages, e.g. NEXT_BASE_PATH=/animestudio-ai
# The deploy workflow sets this automatically. Leave empty for local dev.
NEXT_BASE_PATH=

# ============================================================
# Everything below is for the FUTURE Vercel backend only
# (see docs/api-spec.md). Not used by the static GitHub Pages build.
# ============================================================

# --- Supabase (free tier) ---
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Server dashboard auth (single user, real check) ---
ANIME_STUDIO_PASSWORD=change-me-to-a-long-secret

# --- GPU worker auth ---
# Shared secret workers send as `Authorization: Bearer <token>`.
WORKER_TOKEN=change-me-to-another-long-secret

NEXT_PUBLIC_APP_URL=http://localhost:3000
